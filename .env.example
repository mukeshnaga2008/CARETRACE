# ==============================================================================
# CARETRACE Environment Configuration Template
# PromptWars × Catalyst 2026: Phase 14 Hardening
#
# IMPORTANT SECURITY GUIDELINES:
# 1. NEVER commit production secrets or actual API keys to version control.
# 2. Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
#    DO NOT place secrets, service keys, or private salts in NEXT_PUBLIC_ variables.
# 3. In production, use your hosting platform's encrypted secrets manager
#    (e.g., Supabase Secrets, Vercel Environment Variables, Cloud Secret Manager).
# ==============================================================================

# Application Base URL (Required for canonical URLs, redirects, and notification deep links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Synthetic Demonstration Mode
# Set to "true" for self-contained, instant judge evaluation with pre-seeded personas.
# Set to "false" in staging or production to enforce live Supabase PostgreSQL and Auth.
NEXT_PUBLIC_DEMO_MODE="true"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Safe for client exposure (Row Level Security strictly isolates access):
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# STRICTLY SERVER-ONLY: Never prefix with NEXT_PUBLIC_ or expose to the browser!
# Used exclusively for administrative migrations and system maintenance routines.
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"

# ------------------------------------------------------------------------------
# Notification & Transport Provider Credentials (Server-Only)
# ------------------------------------------------------------------------------
# Optional in demo mode (in-app notifications work standalone):
RESEND_API_KEY="re_placeholder_secret_key"
NOTIFICATION_FROM_EMAIL="alerts@caretrace.health"

# ------------------------------------------------------------------------------
# Background Job & Scheduler Authentication
# ------------------------------------------------------------------------------
# Shared bearer token for protecting background queue execution (/api/notifications/process-queue)
# Generated as a cryptographically strong random token in production.
CRON_SECRET="caretrace-cron-secret-change-in-production-2026"

# ------------------------------------------------------------------------------
# Cryptographic Salts & Hashing
# ------------------------------------------------------------------------------
# Salt used for emergency access verification and secure token generation
ACCESS_PIN_SALT="caretrace-secure-salt-change-in-production-2026"
